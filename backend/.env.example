# Copy to .env and adjust. Never commit .env.

# --- Database (PostgreSQL, psycopg 3 driver) ---
DATABASE_URL=postgresql+psycopg://anime_remix:change-me@localhost:5432/anime_remix
# Used only by pytest; tables are created/dropped automatically. MUST be a separate database.
TEST_DATABASE_URL=postgresql+psycopg://anime_remix:change-me@localhost:5432/anime_remix_test

# --- API ---
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=500

# --- Storage (relative paths are resolved from the backend/ folder) ---
STORAGE_ROOT=storage

# --- FFmpeg (names on PATH, or absolute paths) ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Voice isolation (Demucs) ---
DEMUCS_MODEL=htdemucs
# cpu | cuda
DEMUCS_DEVICE=cpu

# --- Transcription (faster-whisper) ---
# tiny | base | small | medium | large-v3 ...
WHISPER_MODEL=small
# cpu | cuda
WHISPER_DEVICE=cpu
# int8 for CPU; float16 for CUDA
WHISPER_COMPUTE_TYPE=int8

# --- URL import (yt-dlp) ---
IMPORT_ENABLED=true
IMPORT_ALLOWED_DOMAINS=youtube.com,youtu.be,soundcloud.com,vimeo.com,bandcamp.com
IMPORT_MAX_MB=500

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=1.0
WORKER_STALE_JOB_MINUTES=120
